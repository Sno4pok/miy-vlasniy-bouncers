--GUIs
local gui = script.Parent
local background = gui:WaitForChild("Inventory_Background")
local shop_background = gui:WaitForChild("Shop_Background")
local openBtn = gui.Frame:WaitForChild("Inventory_Button")
local closeBtn = background:WaitForChild("Close_Button")



closeBtn.MouseButton1Click:Connect(function()
	background.Visible = false
end)

openBtn.MouseButton1Click:Connect(function()
	shop_background.Visible = false
	background.Visible = true
end)
