--Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

--Folders
local Configs = ReplicatedStorage:WaitForChild("Configs")
local CratesFolder = ReplicatedStorage:WaitForChild("Crates")
local Remotes = ReplicatedStorage:WaitForChild("CustomiseRelatedRemotes")

--Events
local BuyCrate = Remotes:WaitForChild("BuyCrate")
local FinishedOpening = Remotes:WaitForChild("FinishedOpening")

--Modules
local Crates = require(Configs:WaitForChild("Crates"))
local Bats = require(Configs:WaitForChild("Bats"))

--GUIs
local gui = script.Parent
local crateGui = gui.Parent:WaitForChild("CrateGui")
local background = gui:WaitForChild("Shop_Background")
local inventory_background = gui:WaitForChild("Inventory_Background")
local openBtn = gui.Frame:WaitForChild("Shop_Button")
local closeBtn = background:WaitForChild("Close_Button")
local itemFrame = background:WaitForChild("ItemFrame")

-- CrateGui references
local crateBackground = crateGui:WaitForChild("Background")
local openingFrame = crateBackground:WaitForChild("OpeningFrame")
local title = openingFrame:WaitForChild("Title")
local stripContainer = openingFrame:WaitForChild("StripContainer")
local scrollingStrip = stripContainer:WaitForChild("ScrollingStrip")
local stripLayout = scrollingStrip:WaitForChild("UIListLayout")
local itemTemplate = scrollingStrip:WaitForChild("ItemTemplate")
local resultFrame = openingFrame:WaitForChild("ResultFrame")
local resultIcon = resultFrame:WaitForChild("ResultIcon")
local resultName = resultFrame:WaitForChild("ResultName")
local resultRarity = resultFrame:WaitForChild("ResultRarity")
local resultStatus = resultFrame:WaitForChild("ResultStatus")
local continueButton = openingFrame:WaitForChild("ContinueButton")

--Templates
local TEMPLATE = itemFrame:WaitForChild("Template")

--Constants
local ITEM_COUNT = 60
local STOP_INDEX = 45  -- 0-indexed position of the winning item
local ITEM_PADDING_RATIO = 0.08 -- 8% of item size as padding
local SCROLL_DURATION = 5
local RARITY_COLORS = {
	Common = Color3.fromRGB(160, 160, 160),
	Rare = Color3.fromRGB(80, 150, 255),
	Epic = Color3.fromRGB(180, 90, 255),
	Mythic = Color3.fromRGB(255, 200, 60),
	Legendary = Color3.fromRGB(255, 215, 0),
}

-- Get all bat entries for a crate type
local function getBatPool(crateType)
	local pool = Bats[crateType]
	if not pool then return {} end
	local entries = {}
	for name, data in pairs(pool) do
		table.insert(entries, {
			name = name,
			icon = data.Icon or "",
			rarity = data.TheRarity or "Common",
			weight = data.Weight or 1,
		})
	end
	return entries
end

-- Pick a random bat from the pool (weighted)
local function pickRandomBat(pool)
	local totalWeight = 0
	for _, entry in ipairs(pool) do
		totalWeight += entry.weight
	end
	local roll = math.random(1, totalWeight)
	local current = 0
	for _, entry in ipairs(pool) do
		current += entry.weight
		if roll <= current then
			return entry
		end
	end
	return pool[1]
end

local function clearStrip()
	for _, child in ipairs(scrollingStrip:GetChildren()) do
		if child ~= itemTemplate and child ~= stripLayout then
			child:Destroy()
		end
	end
end

local function openCrate(crateType, rewardInfo)
	-- Show the UI first so we can measure the container
	crateBackground.Visible = true
	openingFrame.Visible = true
	resultFrame.Visible = false
	continueButton.Visible = false
	title.Text = "Opening Crate..."
	
	-- Wait a frame for layout to update
	task.wait(0.1)
	
	-- Calculate dynamic item size based on container height
	local containerHeight = stripContainer.AbsoluteSize.Y
	local itemSize = math.max(20, containerHeight)
	local itemPadding = math.max(2, math.floor(itemSize * ITEM_PADDING_RATIO))
	stripLayout.Padding = UDim.new(0, itemPadding)
	
	-- Build the scrolling strip
	clearStrip()
	
	local pool = getBatPool(crateType)
	if #pool == 0 then
		FinishedOpening:FireServer()
		return
	end
	
	-- Build items: random items with the winner at STOP_INDEX (0-indexed)
	local items = {}
	for i = 1, ITEM_COUNT do
		if i == STOP_INDEX + 1 then
			-- Place the winning item
			table.insert(items, {
				name = rewardInfo.batName,
				icon = rewardInfo.icon,
				rarity = rewardInfo.rarity,
			})
		else
			-- Place a random item
			local randomBat = pickRandomBat(pool)
			table.insert(items, randomBat)
		end
	end
	
	-- Create the item frames
	for i, itemData in ipairs(items) do
		local item = itemTemplate:Clone()
		item.Name = "Item" .. i
		item.Visible = true
		item.LayoutOrder = i
		
		local icon = item:FindFirstChild("Icon")
		if icon then
			icon.Image = itemData.icon
		end
		
		local stroke = item:FindFirstChild("RarityStroke")
		if stroke then
			local color = RARITY_COLORS[itemData.rarity] or RARITY_COLORS.Common
			stroke.Color = color
		end
		
		item.Parent = scrollingStrip
	end
	
	-- Set the scrolling strip width to fit all items (initial estimate)
	local itemWidth = itemSize + itemPadding
	local totalStripWidth = ITEM_COUNT * itemWidth
	scrollingStrip.Size = UDim2.new(0, totalStripWidth, 1, 0)
	
	-- Start the strip at the left edge
	scrollingStrip.Position = UDim2.new(0, 0, 0, 0)
	
	-- Wait a frame for layout to update
	task.wait(0.1)
	
	-- Read the ACTUAL rendered item width from the first cloned item.
	-- The UIAspectRatioConstraint (AspectRatio=1, DominantAxis=Height, FitWithinMaxSize)
	-- may clamp the width below our itemSize estimate, so we must measure the real width.
	local firstItem = scrollingStrip:FindFirstChild("Item1")
	local actualItemWidth = itemSize
	if firstItem then
		actualItemWidth = firstItem.AbsoluteSize.X
		if actualItemWidth <= 0 then
			actualItemWidth = itemSize
		end
	end
	
	-- Recalculate strip width and target position using the actual item width
	local actualItemStep = actualItemWidth + itemPadding
	local actualTotalWidth = ITEM_COUNT * actualItemStep
	scrollingStrip.Size = UDim2.new(0, actualTotalWidth, 1, 0)
	
	task.wait(0.1)
	
	local containerWidth = stripContainer.AbsoluteSize.X
	local winnerCenter = STOP_INDEX * actualItemStep + actualItemWidth / 2
	local targetX = containerWidth / 2 - winnerCenter
	
	-- Tween the strip position with Quart Out easing
	local tween = TweenService:Create(
		scrollingStrip,
		TweenInfo.new(SCROLL_DURATION, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		{Position = UDim2.new(0, targetX, 0, 0)}
	)
	
	tween:Play()
	tween.Completed:Wait()
	
	-- Show result
	title.Text = "You Got:"
	resultFrame.Visible = true
	resultIcon.Image = rewardInfo.icon
	resultName.Text = rewardInfo.batName
	resultRarity.Text = rewardInfo.rarity
	
	local rarityColor = RARITY_COLORS[rewardInfo.rarity] or RARITY_COLORS.Common
	resultRarity.TextColor3 = rarityColor
	
	if rewardInfo.isDuplicate then
		resultStatus.Text = "DUPLICATE  (+" .. rewardInfo.compensation .. " Cash)"
		resultStatus.TextColor3 = Color3.fromRGB(255, 170, 0)
	else
		resultStatus.Text = "NEW!"
		resultStatus.TextColor3 = Color3.fromRGB(80, 255, 80)
	end
	
	continueButton.Visible = true
	
	-- Wait for player to click continue (or auto-continue after 10 seconds)
	local continuePressed = false
	local connection
	connection = continueButton.MouseButton1Click:Connect(function()
		continuePressed = true
		if connection then
			connection:Disconnect()
		end
	end)
	
	local elapsed = 0
	while not continuePressed and elapsed < 10 do
		task.wait(0.1)
		elapsed += 0.1
	end
	if connection and connection.Connected then
		connection:Disconnect()
	end
	
	-- Hide UI
	crateBackground.Visible = false
	openingFrame.Visible = false
	resultFrame.Visible = false
	continueButton.Visible = false
	
	-- Clear strip items
	clearStrip()
	
	-- Tell server we're done
	FinishedOpening:FireServer()
end

function generateGui()
	for crateType, crateInfo in pairs(Crates) do
		local crateToClone = CratesFolder:FindFirstChild(crateType .. "Crate")
		if not crateToClone then continue end
		
		local templateCloned = TEMPLATE:Clone()
		templateCloned.Parent = itemFrame
		templateCloned.Name = crateType
		templateCloned.LayoutOrder = crateInfo.LayoutOrder
		
		local crate = crateToClone:Clone()
		crate.Parent = templateCloned
		
		templateCloned.Visible = true
		
		templateCloned:WaitForChild("Header").Text = crateType
		
		local buyButton = templateCloned:WaitForChild("PurchaseButton")
		buyButton.Text = crateInfo.Currency .. ": " .. crateInfo.Amount
		
		buyButton.MouseButton1Click:Connect(function()
			local crateModel, rewardInfo = BuyCrate:InvokeServer(crateType)
			if crateModel and rewardInfo then
				background.Visible = false
				openCrate(crateType, rewardInfo)
			else
				buyButton.BackgroundColor3 = Color3.fromRGB(255, 41, 41)
				task.wait(.5)
				buyButton.BackgroundColor3 = Color3.fromRGB(85, 255, 0)
			end
		end)
	end
end

generateGui()

closeBtn.MouseButton1Click:Connect(function()
	background.Visible = false
end)

openBtn.MouseButton1Click:Connect(function()
	inventory_background.Visible = false
	background.Visible = true
end)
