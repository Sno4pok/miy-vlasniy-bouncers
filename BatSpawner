local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")

local inRound = ReplicatedStorage:WaitForChild("InRound")
local batEvent = ReplicatedStorage:WaitForChild("BatEvent")
local gameModeValue = ReplicatedStorage:WaitForChild("GameMode")
local bat = ServerStorage:WaitForChild("Bat")

local playingTeam = Teams.Playing
local redTeam = nil
local blueTeam = nil

local currentBatHolders = {} -- Changed to table to support multiple holders
local roundActive = false

-- Game mode modules
local GameModes = ReplicatedStorage:WaitForChild("GameModes")
local ClassicMode = require(GameModes:WaitForChild("ClassicMode"))
local TeamDeathMatch = require(GameModes:WaitForChild("TeamDeathMatch"))
local InsanityMode = require(GameModes:WaitForChild("InsanityMode"))

local currentGameMode = nil

-- Function to get all players in game based on current mode
local function getPlayingPlayers()
	local playing = {}
	local modeName = gameModeValue.Value
	
	if modeName == "Team Death Match" then
		-- Get players from both Red and Blue teams
		for _, plr in Players:GetPlayers() do
			if plr.Team and (plr.Team.Name == "Red" or plr.Team.Name == "Blue") then
				table.insert(playing, plr)
			end
		end
	else
		-- Classic and Insanity use Playing team
		for _, plr in Players:GetPlayers() do
			if plr.Team == playingTeam then
				table.insert(playing, plr)
			end
		end
	end
	
	return playing
end

-- Function to remove all bats from current holders
local function removeAllBats()
	for _, holder in pairs(currentBatHolders) do
		if holder and holder.Character then
			local backpack = holder:FindFirstChild("Backpack")
			if backpack then
				for _, item in backpack:GetChildren() do
					if item.Name == "Bat" then
						item:Destroy()
					end
				end
			end
			local character = holder.Character
			for _, item in character:GetChildren() do
				if item:IsA("Tool") and item.Name == "Bat" then
					item:Destroy()
				end
			end
		end
	end
	currentBatHolders = {}
end

-- Function to give bat to a player
local function giveBatToPlayer(player)
	if not player.Character then return nil end
	
	local batClone = bat:Clone()
	batClone.Parent = player.Character -- This equips it directly
	
	return player
end

-- Function to give bats to multiple players (for Insanity mode)
local function giveBatsToMultiplePlayers(players)
	local holders = {}
	for _, player in pairs(players) do
		local holder = giveBatToPlayer(player)
		if holder then
			table.insert(holders, holder)
		end
	end
	return holders
end

-- Main bat spawning cycle for single bat mode (Classic and Team Death Match)
local function runSingleBatCycle()
	while roundActive do
		-- 10 second countdown before bat appears
		for i = 10, 1, -1 do
			if not roundActive then return end
			batEvent:FireAllClients("countdown", i)
			task.wait(1)
		end
		
		-- Check if round is still active and there are players
		local playingPlayers = getPlayingPlayers()
		if not roundActive or #playingPlayers < 1 then
			batEvent:FireAllClients("hide")
			return
		end
		
		-- Pick a random player
		local randomPlayer = playingPlayers[math.random(1, #playingPlayers)]
		removeAllBats()
		local holder = giveBatToPlayer(randomPlayer)
		if holder then
			currentBatHolders = {holder}
			batEvent:FireAllClients("batReceived", holder.Name)
		end
		
		-- Bat stays for 10 seconds
		for i = 10, 1, -1 do
			if not roundActive then 
				removeAllBats()
				batEvent:FireAllClients("hide")
				return 
			end
			batEvent:FireAllClients("batTimer", i)
			task.wait(1)
		end
		
		-- Remove bat after 10 seconds
		removeAllBats()
		batEvent:FireAllClients("batRemoved")
		
		-- No wait here - immediately start next countdown cycle
	end
end

-- Main bat spawning cycle for multiple bat mode (Insanity)
local function runMultipleBatCycle()
	while roundActive do
		-- 10 second countdown before bat appears
		for i = 10, 1, -1 do
			if not roundActive then return end
			batEvent:FireAllClients("countdown", i)
			task.wait(1)
		end
		
		-- Check if round is still active and there are players
		local playingPlayers = getPlayingPlayers()
		if not roundActive or #playingPlayers < 1 then
			batEvent:FireAllClients("hide")
			return
		end
		
		-- Determine how many players get the bat (1-3)
		local numBats = InsanityMode:GetRandomBatCount(playingPlayers)
		
		-- Pick random players
		local selectedPlayers = {}
		local availablePlayers = {} -- Copy the table
		for _, plr in pairs(playingPlayers) do
			table.insert(availablePlayers, plr)
		end
		
		for i = 1, numBats do
			if #availablePlayers > 0 then
				local randomIndex = math.random(1, #availablePlayers)
				table.insert(selectedPlayers, availablePlayers[randomIndex])
				table.remove(availablePlayers, randomIndex)
			end
		end
		
		-- Give bats to selected players
		removeAllBats()
		currentBatHolders = giveBatsToMultiplePlayers(selectedPlayers)
		
		-- Notify clients about multiple bat holders
		local holderNames = {}
		for _, holder in pairs(currentBatHolders) do
			table.insert(holderNames, holder.Name)
		end
		batEvent:FireAllClients("batReceived", table.concat(holderNames, ", "))
		
		-- Bat stays for 10 seconds
		for i = 10, 1, -1 do
			if not roundActive then 
				removeAllBats()
				batEvent:FireAllClients("hide")
				return 
			end
			batEvent:FireAllClients("batTimer", i)
			task.wait(1)
		end
		
		-- Remove bats after 10 seconds
		removeAllBats()
		batEvent:FireAllClients("batRemoved")
		
		-- No wait here - immediately start next countdown cycle
	end
end

-- Listen for round start/end
inRound.Changed:Connect(function()
	if inRound.Value == true then
		-- Round started
		roundActive = true
		task.wait(1) -- Wait for players to be moved
		
		-- Determine which bat cycle to run based on game mode
		local modeName = gameModeValue.Value
		if modeName == "Insanity" then
			task.spawn(runMultipleBatCycle)
		else
			task.spawn(runSingleBatCycle)
		end
	else
		-- Round ended
		roundActive = false
		removeAllBats()
		batEvent:FireAllClients("hide")
	end
end)

-- Handle player death - remove bat if holder dies
Players.PlayerRemoving:Connect(function(player)
	-- Check if player is a bat holder
	for i, holder in pairs(currentBatHolders) do
		if holder == player then
			table.remove(currentBatHolders, i)
			break
		end
	end
end)
