local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")

-- Require modules
local VotingModule = require(ReplicatedStorage:WaitForChild("VotingModule"))
local RewardManager = require(script.Parent:WaitForChild("RewardManager"))

local intermission = 20
local roundLenght = 300

-- Minimum non-AFK players required for a round to run (prevents solo win farming)
-- Shared from VotingModule so the eligibility rules live in one place
local MIN_PLAYERS = VotingModule.MIN_PLAYERS
local getEligiblePlayerCount = VotingModule.GetEligiblePlayerCount

local inRound = ReplicatedStorage:WaitForChild("InRound")
local status = ReplicatedStorage:WaitForChild("Status")
local gameModeValue = ReplicatedStorage:WaitForChild("GameMode")

local playingTeam = Teams.Playing
local lobbyTeam = Teams.Lobby

-- Game mode modules
local GameModes = ReplicatedStorage:WaitForChild("GameModes")
local ClassicMode = require(GameModes:WaitForChild("ClassicMode"))
local TeamDeathMatch = require(GameModes:WaitForChild("TeamDeathMatch"))
local InsanityMode = require(GameModes:WaitForChild("InsanityMode"))

local currentGameMode = nil

-- How many players actually entered the current round (used to block solo payouts)
local playersInCurrentRound = 0
local teams = {
	Playing = playingTeam,
	Lobby = lobbyTeam
}

-- Spawn management ----------------------------------------------------------
local gameSpawnsFolder = game.Workspace:FindFirstChild("GameSpawns")
local lobbySpawn = game.Workspace:FindFirstChild("lobbySpawn")

local function getSpawnPoints()
	local spawns = {}
	if gameSpawnsFolder then
		for _, child in gameSpawnsFolder:GetChildren() do
			if child:IsA("BasePart") then
				table.insert(spawns, child)
			end
		end
	end
	return spawns
end

-- Fisher-Yates shuffle so spawn assignments are random every round
local function shuffle(t)
	for i = #t, 2, -1 do
		local j = math.random(1, i)
		t[i], t[j] = t[j], t[i]
	end
	return t
end

-- Eliminated players respawn in the lobby and wait for the next round
local function returnToLobby(player)
	local connection
	connection = player.CharacterAdded:Connect(function(char)
		connection:Disconnect()
		if lobbySpawn then
			local hrp = char:WaitForChild("HumanoidRootPart", 5)
			if hrp then
				char:PivotTo(lobbySpawn.CFrame * CFrame.new(0, 3.5, 0))
			end
		end
	end)
end

-- Players who join mid-round wait in the lobby for the next one
Players.PlayerAdded:Connect(function(player)
	player.Team = lobbyTeam
end)

-- Award wins and cash based on the round result -----------------------------
local function awardWinners(winType)
	-- Defense in depth: never pay out a round that started with too few players
	if playersInCurrentRound < MIN_PLAYERS then
		return
	end

	if winType == "winner" then
		-- FFA modes (Classic/Insanity): last player on the Playing team wins
		for _, plr in Players:GetPlayers() do
			if plr.Team == playingTeam then
				RewardManager.AwardForWin(plr)
			end
		end
	elseif winType == "team" then
		-- Team Death Match: everyone on the surviving team wins
		for _, teamName in {"Red", "Blue"} do
			local team = Teams:FindFirstChild(teamName)
			if team then
				local hasMembers = false
				for _, plr in Players:GetPlayers() do
					if plr.Team == team then
						hasMembers = true
						break
					end
				end
				if hasMembers then
					for _, plr in Players:GetPlayers() do
						if plr.Team == team then
							RewardManager.AwardForWin(plr)
						end
					end
				end
			end
		end
	end
end

-- Handle player leaving during round
Players.PlayerRemoving:Connect(function(player)
	if inRound.Value == true and currentGameMode then
		local winType, winMessage = currentGameMode:CheckWinCondition(Players:GetPlayers())
		if winType then
			-- Award before ending the round (ending it moves everyone to Lobby team)
			awardWinners(winType)
			status.Value = winMessage
			inRound.Value = false
			task.wait(3)
		end
	end
end)

inRound.Changed:Connect(function()

	if inRound.Value == true then
		playersInCurrentRound = 0

		-- Get current game mode
		local modeName = gameModeValue.Value
		if modeName == "Classic" then
			currentGameMode = ClassicMode
		elseif modeName == "Team Death Match" then
			currentGameMode = TeamDeathMatch
		elseif modeName == "Insanity" then
			currentGameMode = InsanityMode
		end

		-- Setup teams for game mode
		currentGameMode:SetupTeams(teams)

		-- Move players to game
		local spawns = shuffle(getSpawnPoints())
		local spawnIndex = 1
		for i, plr in pairs(Players:GetChildren()) do

			if not plr:FindFirstChild("IsAFK") then

				local char = plr.Character
				if char then
					-- Spread players across shuffled spawn points
					if #spawns > 0 then
						local spawnPoint = spawns[spawnIndex]
						spawnIndex = spawnIndex % #spawns + 1

						-- +3.5 studs up so the pivot doesn't clip into the floor
						char:PivotTo(spawnPoint.CFrame * CFrame.new(0, 3.5, 0))

						-- kill leftover velocity so mid-bounce players aren't flung on arrival
						local humRoot = char:FindFirstChild("HumanoidRootPart")
						if humRoot then
							humRoot.AssemblyLinearVelocity = Vector3.zero
						end
					end

					-- Assign teams based on game mode
					if currentGameMode.Name == "Team Death Match" then
						currentGameMode:AssignTeams(Players:GetPlayers())
					else
						plr.Team = playingTeam
					end

					-- Track how many players actually entered this round
					playersInCurrentRound += 1

					-- Handle death
					local humanoid = char:FindFirstChild("Humanoid")
					if humanoid then
						humanoid.Died:Connect(function()
							currentGameMode:OnPlayerDeath(plr, teams)
							returnToLobby(plr)
						end)
					end
				end

			end


		end

	else	
		-- Round ended, move everyone to lobby
		currentGameMode = nil
		playersInCurrentRound = 0
		for i, plr in pairs(Players:GetChildren()) do

			local char = plr.Character
			if char then
				local humRoot = char:FindFirstChild("HumanoidRootPart")
				if humRoot then
					humRoot.CFrame = game.Workspace.lobbySpawn.CFrame
				end
			end

			plr.Team = lobbyTeam

		end
	end 

end)

local function round()

	while true do 

		inRound.Value = false

		-- WAITING PHASE - Hold until enough eligible players (prevents solo farming)
		while getEligiblePlayerCount() < MIN_PLAYERS do
			status.Value = "Waiting for players ("..getEligiblePlayerCount().."/"..MIN_PLAYERS..")..."
			task.wait(1)
		end

		-- INTERMISSION PHASE - Always show intermission first
		for i = intermission, 0, -1 do 
			status.Value = "Intermission: "..i.." seconds"
			task.wait(1)
		end

		-- VOTING PHASE - Start voting after intermission.
		-- Returns false when too few eligible players remain at round start.
		if not VotingModule.StartVoting() then
			task.wait(3)
			continue
		end

		-- Wait for players to be moved
		task.wait(1)

		-- Main round loop
		for i = roundLenght, 0, -1 do 

			status.Value = ""

			-- Check win condition based on game mode
			if currentGameMode then
				local winType, winMessage = currentGameMode:CheckWinCondition(Players:GetPlayers())

				if winType then
					-- Award before ending the round (ending it moves everyone to Lobby team)
					awardWinners(winType)
					status.Value = winMessage
					inRound.Value = false
					task.wait(3)
					break
				end
			end

			task.wait(1)
		end

	end
end

task.spawn(round)
