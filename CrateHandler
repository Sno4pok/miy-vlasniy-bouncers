--Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

--Folders
local Configs = ReplicatedStorage.Configs
local Remotes = ReplicatedStorage.CustomiseRelatedRemotes
local CratesFolder = ReplicatedStorage.Crates
local BatsFolder = ReplicatedStorage.Bats

--Modules
local Crates = require(Configs.Crates)
local Bats = require(Configs.Bats)

--Tables
local cratesBeingOpened = {} -- [userId] = {crateType = ..., batName = ..., isDuplicate = ..., compensation = ...}
local pendingRobuxPurchases = {} -- [userId] = crateType

function rollRandomBat(crateType:string)
	local pool = Bats[crateType]
	if not pool then return nil, nil end
	
	local totalWeight = 0
	for _, data in pairs(pool) do
		totalWeight += data.Weight
	end
	
	local roll = math.random(1, totalWeight)
	local current = 0
	for name, data in pairs(pool) do
		current += data.Weight
		if roll <= current then
			return name, data
		end
	end
	return nil, nil
end

-- Shared helper: rolls the reward, sets IsOpening, stores result, returns reward info
local function startCrateOpening(plr:Player, crateType:string)
	local crateToClone = CratesFolder:FindFirstChild(crateType .. "Crate")
	if not crateToClone then return nil end
	
	local batName, batData = rollRandomBat(crateType)
	if not batName or not batData then return nil end
	
	local playerBats = plr:FindFirstChild("Bats")
	local isDuplicate = false
	if playerBats and playerBats:FindFirstChild(batName) then
		isDuplicate = true
	end
	
	local isOpening = plr:FindFirstChild("IsOpening")
	if isOpening then
		isOpening.Value = true
	end
	
	cratesBeingOpened[plr.UserId] = {
		crateType = crateType,
		batName = batName,
		isDuplicate = isDuplicate,
		compensation = batData.Compensation or 0,
	}
	
	return {
		batName = batName,
		rarity = batData.TheRarity or "Common",
		icon = batData.Icon or "",
		isDuplicate = isDuplicate,
		compensation = batData.Compensation or 0,
	}
end

Remotes.BuyCrate.OnServerInvoke = function(plr:Player, crateType:string)
	--Checking if is opening
	local isOpening = plr:FindFirstChild("IsOpening")
	if isOpening.Value == true then return end
	
	local crateInfo = Crates[crateType]
	if not crateInfo then return end
	
	-- ROBUX PURCHASE BRANCH
	if crateInfo.Currency == "Robux" then
		if not crateInfo.ProductId then return end
		-- Prevent double-prompting
		if pendingRobuxPurchases[plr.UserId] then return end
		pendingRobuxPurchases[plr.UserId] = crateType
		MarketplaceService:PromptProductPurchase(plr, crateInfo.ProductId)
		-- Return a signal so the client knows a purchase prompt is shown
		return nil, { promptPurchase = true }
	end
	
	-- CASH PURCHASE FLOW
	local leaderstats = plr:FindFirstChild("leaderstats")
	if not leaderstats then return end
	
	local currencyStat = leaderstats:FindFirstChild(crateInfo.Currency)
	if not currencyStat or currencyStat.Value < crateInfo.Amount then return end
	
	local rewardInfo = startCrateOpening(plr, crateType)
	if not rewardInfo then return end
	
	--Deducting
	currencyStat.Value -= crateInfo.Amount
	
	-- Return reward info so client can build the animation
	return rewardInfo
end

-- Called by ReceiptHandler when a Robux purchase is confirmed
-- Rolls the reward and fires the client to start the opening animation
Remotes.RobuxPurchaseCompleted.Event:Connect(function(plr:Player)
	local crateType = pendingRobuxPurchases[plr.UserId]
	if not crateType then return end
	pendingRobuxPurchases[plr.UserId] = nil
	
	local rewardInfo = startCrateOpening(plr, crateType)
	if not rewardInfo then return end
	
	-- Fire the client to start the opening animation
	Remotes.RobuxCrateResult:FireClient(plr, crateType, rewardInfo)
end)

local function processReward(plr:Player)
	local data = cratesBeingOpened[plr.UserId]
	if not data then return end
	
	local crateType = data.crateType
	local batName = data.batName
	local isDuplicate = data.isDuplicate
	
	local playerBats = plr:FindFirstChild("Bats")
	local leaderstats = plr:FindFirstChild("leaderstats")
	
	if isDuplicate then
		-- Duplicate! Give compensation
		local batData = Bats[crateType] and Bats[crateType][batName]
		if batData and batData.Compensation then
			local crateInfo = Crates[crateType]
			local currencyStat = leaderstats and leaderstats:FindFirstChild(crateInfo and crateInfo.Currency or "Cash")
			if currencyStat then
				currencyStat.Value += batData.Compensation
				print("Duplicate bat!", batName, "- Compensation:", batData.Compensation)
			end
		end
	else
		-- New bat! Create BoolValue
		if playerBats and not playerBats:FindFirstChild(batName) then
			local batValue = Instance.new("BoolValue")
			batValue.Value = true
			batValue.Name = batName
			batValue.Parent = playerBats
			print("Player got:", batName)
		end
	end
	
	local isOpening = plr:FindFirstChild("IsOpening")
	if isOpening then
		isOpening.Value = false
	end
	cratesBeingOpened[plr.UserId] = nil
	
	-- Pass the equipped bat so the UI maintains the correct state
	local equippedBatValue = plr:FindFirstChild("EquippedBat")
	local savedEquippedBat = equippedBatValue and equippedBatValue.Value or ""
	if playerBats then
		Remotes.LoadInventory:Fire(plr, playerBats, savedEquippedBat)
	end
end

Remotes.FinishedOpening.OnServerEvent:Connect(function(plr:Player)
	processReward(plr)
end)

-- Grant pending reward if player leaves before clicking Continue
local Players = game:GetService("Players")
Players.PlayerRemoving:Connect(function(plr:Player)
	processReward(plr)
	pendingRobuxPurchases[plr.UserId] = nil
end)
