local InsanityMode = {}

InsanityMode.Name = "Insanity"
InsanityMode.Description = "1-3 players get the bat randomly!"
InsanityMode.Teams = {"Playing", "Lobby"}
InsanityMode.BatMode = "multiple" -- 1-3 players can get the bat

function InsanityMode:SetupTeams(teams)
	-- Insanity mode uses existing Playing and Lobby teams
	-- No additional setup needed
end

function InsanityMode:GetPlayersInGame(players)
	local playingPlayers = {}
	for _, player in pairs(players) do
		if player.Team and player.Team.Name == "Playing" then
			table.insert(playingPlayers, player)
		end
	end
	return playingPlayers
end

function InsanityMode:CheckWinCondition(players)
	local playingPlayers = self:GetPlayersInGame(players)
	
	if #playingPlayers == 0 then
		return "none", "Everyone has died"
	elseif #playingPlayers == 1 then
		return "winner", playingPlayers[1].Name .. " has won!"
	end
	
	return nil, nil
end

function InsanityMode:OnPlayerDeath(player, teams)
	-- Move dead player to Lobby team
	player.Team = teams.Lobby
end

function InsanityMode:GetRandomBatCount(playersInGame)
	-- Randomly choose 1-3 players to get the bat
	local maxBats = math.min(3, #playersInGame)
	return math.random(1, maxBats)
end

return InsanityMode
